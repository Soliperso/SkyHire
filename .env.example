# SkyHire frontend env — copy to .env.local and fill in.
# These are PUBLIC client keys (safe to expose in the browser); RLS guards the data.
# Find them in the Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Secret passcode required to sign in as the admin (operator-only console).
VITE_ADMIN_PASSCODE=choose-a-strong-passcode
