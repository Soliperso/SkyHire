# SkyHire frontend env — copy to .env.local and fill in.
# These are PUBLIC client keys (safe to expose in the browser); RLS guards the data.
# Find them in the Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Auth is real Supabase Auth. Roles (client/pilot/admin) live in public.users
# and are enforced by RLS — admin access = the admin account's credentials, no
# separate env var. Demo accounts are seeded via scripts/seed-auth.mjs.
